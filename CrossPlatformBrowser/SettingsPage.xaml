<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CrossPlatformBrowser.SettingsPage"
             Title="Настройки"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

    <VerticalStackLayout Padding="20" Spacing="16">

        <Grid ColumnDefinitions="*, Auto">
            <Label Text="Настройки браузера" FontSize="24" FontAttributes="Bold" />
            <Button Grid.Column="1" Text="Закрыть" Clicked="OnCloseButtonClicked" />
        </Grid>

        <Label Text="Домашняя страница" FontSize="16" FontAttributes="Bold" />
        <Entry x:Name="HomePageEntry" Placeholder="Например: https://example.com" />

        <Label Text="Поисковая система" FontSize="16" FontAttributes="Bold" />
        <Picker x:Name="SearchEnginePicker">
            <Picker.Items>
                <x:String>Google</x:String>
                <x:String>Яндекс</x:String>
                <x:String>Bing</x:String>
            </Picker.Items>
        </Picker>

        <HorizontalStackLayout Spacing="10">
            <Label Text="Тёмная тема" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
            <Switch x:Name="DarkModeSwitch" VerticalOptions="Center" />
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>
