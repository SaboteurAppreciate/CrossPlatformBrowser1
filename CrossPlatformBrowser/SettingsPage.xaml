<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CrossPlatformBrowser.SettingsPage"
             Title="Настройки"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Grid ColumnDefinitions="*, Auto">
            <Label Text="Настройки браузера" FontSize="24" FontAttributes="Bold" />
            <Button Grid.Column="1" Text="Закрыть" Clicked="OnCloseButtonClicked" />
        </Grid>

        <!-- Выбор темы -->
        <Label Text="Тема оформления:" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0"/>
        <Picker x:Name="ThemePicker" SelectedIndexChanged="OnThemeChanged">
            <Picker.Items>
                <x:String>Системная</x:String>
                <x:String>Светлая</x:String>
                <x:String>Темная</x:String>
            </Picker.Items>
        </Picker>

        <!-- Выбор поисковика -->
        <Label Text="Поисковая система:" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0"/>
        <Picker x:Name="SearchEnginePicker" SelectedIndexChanged="OnSearchEngineChanged">
            <Picker.Items>
                <x:String>Google</x:String>
                <x:String>Яндекс</x:String>
                <x:String>Bing</x:String>
            </Picker.Items>
        </Picker>

    </VerticalStackLayout>
</ContentPage>